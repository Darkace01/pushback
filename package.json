{
  "name": "pushback",
  "version": "0.11.0",
  "description": "Pushback: a fast, customizable desktop dashboard for GitHub Actions and pull requests",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --publish never",
    "icon": "node --no-warnings scripts/render-icon.mts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "test:all": "npm run typecheck && npm run test:coverage && npm run test:e2e",
    "screenshots": "electron-vite build && node -e \"process.env.SCREENSHOTS=1;require('child_process').execSync('npx playwright test e2e/screenshots.spec.ts',{stdio:'inherit',env:process.env})\""
  },
  "author": "Kazeem Quadri",
  "license": "MIT",
  "homepage": "https://github.com/Darkace01/pushback",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkace01/pushback.git"
  },
  "bugs": "https://github.com/Darkace01/pushback/issues",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "libsodium-wrappers": "^0.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  },
  "productName": "Pushback",
  "build": {
    "appId": "dev.pushback.app",
    "productName": "Pushback",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Kazeem Quadri <noreply@users.noreply.github.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "Darkace01",
      "repo": "pushback"
    }
  }
}
